# HTTPS / Let's Encrypt / Cloudflare DNS-01
# Dominio publico donde se publicara Nexus CMDB.
APP_URL='https://dev-nexuscmdb.reflab.dev'
# Puerto interno donde escucha la aplicacion Node dentro de Docker.
APP_PORT='3002'
# Puerto HTTPS publicado por Nginx en el servidor.
NGINX_HTTPS_PORT='3002'
CERTBOT_DOMAIN='dev-nexuscmdb.reflab.dev'
CERTBOT_EMAIL='admin@reflab.dev'
CLOUDFLARE_API_TOKEN='CHANGE_ME_CLOUDFLARE_DNS_API_TOKEN'
CERTBOT_RENEW_BEFORE_DAYS='30'
CERTBOT_DNS_PROPAGATION_SECONDS='60'
CERTBOT_STAGING='0'
NGINX_CERT_RELOAD_INTERVAL='12h'
TZ='Europe/Madrid'

# PostgreSQL
POSTGRES_DB='nexus_cmdb'
POSTGRES_USER='nexus_user'
POSTGRES_PASSWORD='CHANGE_ME_POSTGRES_PASSWORD'

# Clave usada para cifrar secretos de AD/Jira en BBDD. Debe ser estable y privada.
APP_ENCRYPTION_KEY='CHANGE_ME_64_CHAR_RANDOM_SECRET_FOR_NEXUS_CMDB_ENCRYPTION'
# Opcional durante rotacion de clave: permite leer secretos antiguos y re-cifrarlos con APP_ENCRYPTION_KEY.
APP_ENCRYPTION_KEY_PREVIOUS=''
REQUIRE_STRONG_SECRETS='true'

# Endurecimiento de autenticacion local
AUTH_FAILURE_MAX_ATTEMPTS='8'
AUTH_FAILURE_WINDOW_MS='900000'
PASSWORD_SCRYPT_N='131072'
PASSWORD_SCRYPT_R='8'
PASSWORD_SCRYPT_P='1'
PASSWORD_SCRYPT_MAXMEM='268435456'
COOKIE_SECURE='true'

# Nutanix
# Opcional: solo se usa si no hay contrasena guardada cifrada en BBDD.
NUTANIX_PASSWORD=''
NUTANIX_REQUEST_TIMEOUT_MS='15000'
ALLOW_INSECURE_NUTANIX_HTTP='false'
